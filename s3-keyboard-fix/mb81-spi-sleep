#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# mb81-spi-sleep — systemd-sleep hook for the 12" MacBook (MacBook8,1)
# Install to: /usr/lib/systemd/system-sleep/mb81-spi-sleep  (mode 0755)
#
# Problem: after S3 ("deep") suspend the internal keyboard and trackpad are dead;
# the kernel log fills with "applespi ... SPI transfer timed out".
#
# Root cause (observed on MacBook8,1, Wildcat Point-LP LPSS in PCI mode):
# on S3 resume the Apple firmware does not re-initialise the private LPSS
# registers of the GSPI controller (8086:9ce6). After resume we read
#     BAR0+0x800  PRV_CLOCK  = 0x00000000   -> SSP clock gated
#     BAR0+0x804  PRV_RESETS = 0x00000000   -> controller held in reset
# (on a working system the controller is out of reset and clocked). spi-pxa2xx-pci
# never writes these registers, so the controller raises no interrupts and every
# transfer times out. Re-binding the driver or a PCI remove/rescan does not help.
#
# Fix: before S3 unload applespi, unbind the SPI controller and save PRV_CLOCK;
# after resume deassert reset (0x804 = 0x3), write PRV_CLOCK back, bind again.
# s2idle keeps the block powered, so the hook does nothing unless deep sleep is used.
#
# Bluetooth: the LPSS UART (8086:9ce3, Broadcom BT via serdev) loses PRV_RESETS the
# same way. Unbinding 8250_lpss is not an option (the kernel does not re-create the
# serdev/Bluetooth device afterwards), so the reset is written while 8250_lpss stays
# bound. That needs the kernel parameter iomem=relaxed; without it this part is
# skipped. hci_uart_bcm is unbound before sleep and re-bound after the fix, which
# re-initialises the Bluetooth chip.
# If the keyboard still does not respond, it falls back to s2idle until reboot.

PCI_ID="8086:9ce6"                      # Wildcat Point-LP Serial IO GSPI #1
DRV=/sys/bus/pci/drivers/pxa2xx_spi_pci
STATE=/run/mb81-spi-sleep.active
UART_ID="8086:9ce3"                     # Wildcat Point-LP Serial IO UART #0 (Bluetooth)
BT_DRV=/sys/bus/serial/drivers/hci_uart_bcm
BT_STATE=/run/mb81-spi-sleep.bt
log(){ logger -t mb81-spi-sleep "$*"; }

grep -qx "MacBook8,1" /sys/class/dmi/id/product_name 2>/dev/null || exit 0

DEV=""
for d in /sys/bus/pci/devices/*; do
    [ "$(cat $d/vendor):$(cat $d/device)" = "0x${PCI_ID%%:*}:0x${PCI_ID##*:}" ] && DEV=${d##*/} && break
done
[ -n "$DEV" ] || { log "GSPI controller $PCI_ID not found"; exit 0; }
UART=""
for d in /sys/bus/pci/devices/*; do
    [ "$(cat $d/vendor):$(cat $d/device)" = "0x${UART_ID%%:*}:0x${UART_ID##*:}" ] && UART=${d##*/} && break
done

# LPSS private registers BAR0+0x800..0x820 (9 dwords): CLOCK, RESETS, GENERAL,
# SSP/-, SW_LTR, AUTO_LTR, CS_CTRL/0x818, -, TX_INT (0x820, bit 1 = TX_INT_MASK
# on the UART). In ACPI mode Linux saves/restores exactly this block across
# suspend (drivers/acpi/acpi_lpss.c, LPSS_SAVE_CTX); in PCI mode nothing does.
# After S3 the firmware leaves it zeroed. A missing TX_INT_MASK on the UART lets
# the LPSS raise TX interrupts nobody handles -> "irq 21: nobody cared" -> the
# kernel disables the IRQ shared by Bluetooth and the keyboard.
#
# lpss save|restore <pci-dev> <file> — save before sleep, restore after resume.
lpss() {
python3 -I - "$1" "$2" "$3" <<'PY' 2>&1 | logger -t mb81-spi-sleep
import mmap, os, struct, sys
mode, dev, save = sys.argv[1:4]
f = os.open(f"/sys/bus/pci/devices/{dev}/resource0", os.O_RDWR | os.O_SYNC)
m = mmap.mmap(f, 4096, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
r = lambda o: struct.unpack_from('<I', m, o)[0]
def w(o, v): struct.pack_into('<I', m, o, v)
OFFS = range(0x800, 0x824, 4)
fmt = lambda: " ".join(f"{r(o):08x}" for o in OFFS)
if mode == "save":
    vals = [r(o) for o in OFFS]
    if vals[1] == 0x3:                    # only save a sane (out-of-reset) state
        open(save, "w").write(" ".join(f"{v:#010x}" for v in vals) + "\n")
    print(f"lpss save {dev}: {fmt()}")
else:
    try:
        vals = [int(x, 16) for x in open(save).read().split()]
    except (OSError, ValueError):
        vals = None
    before = fmt()
    w(0x804, 0x0); w(0x804, 0x3)          # assert, then deassert func + APB reset
    if vals and len(vals) == 9:
        for o, v in zip(OFFS, vals):
            if o not in (0x800, 0x804):
                w(o, v)
        w(0x800, vals[0])                 # clock last (incl. update bit)
        note = ""
    else:
        w(0x800, r(0x800) | 0x1)
        note = " (no saved state: reset + clock enable only)"
    print(f"lpss restore {dev}: {before} -> {fmt()}{note}")
m.close(); os.close(f)
PY
}

case "$1" in
  pre)
    grep -q '\[deep\]' /sys/power/mem_sleep || exit 0
    case "$2" in suspend|hybrid-sleep|suspend-then-hibernate) ;; *) exit 0;; esac
    touch "$STATE"
    log "pre: unloading applespi, unbinding $DEV"
    modprobe -r applespi
    [ -e "$DRV/$DEV" ] && echo "$DEV" > "$DRV/unbind"
    lpss save "$DEV" /run/mb81-spi-sleep.spi
    if [ -n "$UART" ] && grep -qw "iomem=relaxed" /proc/cmdline; then
        lpss save "$UART" /run/mb81-spi-sleep.uart
        for b in "$BT_DRV"/serial*; do
            [ -e "$b" ] || continue
            n=${b##*/}; echo "$n" > "$BT_STATE"
            log "pre: unbinding Bluetooth $n from hci_uart_bcm"
            echo "$n" > "$BT_DRV/unbind"
        done
    fi
    ;;
  post)
    [ -e "$STATE" ] || exit 0
    rm -f "$STATE"
    setpci -s "${DEV#0000:}" COMMAND.w=0006     # memory decode + bus master
    lpss restore "$DEV" /run/mb81-spi-sleep.spi
    echo "$DEV" > "$DRV/bind"
    modprobe applespi
    if [ -n "$UART" ] && grep -qw "iomem=relaxed" /proc/cmdline; then
        lpss restore "$UART" /run/mb81-spi-sleep.uart
        if [ -s "$BT_STATE" ]; then
            n=$(cat "$BT_STATE"); rm -f "$BT_STATE"
            echo "$n" > "$BT_DRV/bind" && log "post: Bluetooth $n re-bound"
        fi
    fi
    sleep 2
    if journalctl -k --since -2s | grep -q "applespi.*timed out"; then
        log "post: applespi still failing -> using s2idle for the next sleep"
        echo s2idle > /sys/power/mem_sleep
    else
        log "post: applespi OK"
    fi
    ;;
esac
exit 0
